// Ad-hoc, for the ProteinMPNN seeding-patch test only. Points
// DL_BINDER_DESIGN_PROTEINMPNN at the patched image (adds torch/random/numpy
// seeding to dl_interface_design.py, which never seeded its RNG - that's why
// non-NIM ProteinMPNN wasn't reproducing itself run to run). Use with
// `-c ad_hoc_mixed.config -c ad_hoc_pmpnn_seed_patch_test.config`.
process {
    withName: '.*MPNN_OSS.*' {
        container = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims:proteinmpnn-seed-patch-v2'
    }
}
