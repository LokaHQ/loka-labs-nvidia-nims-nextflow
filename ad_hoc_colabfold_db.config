// Ad-hoc supplement for msa_colabfold_db_download.nf. Use with
// `-profile aws_batch_nims -c ad_hoc_colabfold_db.config`.
//
// Runs as root to write to the FSx root, then hands ownership to the uid the
// containers run as - the same dance the NIM database loader needed.
aws {
    batch {
        volumes = ['/fsx:/fsx:rw']
    }
}

process {
    withName: DOWNLOAD_COLABFOLD_DATABASES {
        queue = 'nvidia-nims-cpu-small'
        container = 'quay.io/nf-core/proteinfold_colabfold:1.1.1'
        containerOptions = '--user root'
        cpus = 8
        memory = '24g'
        // ~220 GB compressed over HTTP, then unpacked. The NIM's 1.2 TB took
        // 89 minutes; this is smaller but comes from a university mirror
        // rather than NGC, so allow much longer.
        time = 24.hours
        // The download resumes with curl -C -, so a retry continues rather
        // than restarting.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries = 3
    }
}
