// Same baseline (no NIMs) infrastructure as aws_batch.config, scoring via
// OpenFold3 instead of AF2 initial-guess.

docker {
    enabled = true
}
apptainer {
    enabled = false
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/opt/aws-cli/bin/aws'
        // RFDIFFUSION_STANDALONE reads the NGC key from Secrets Manager to
        // fetch the model weights, so this arm needs the same job role the NIM
        // arm uses. Without it the key lookup falls back to whatever role the
        // instance carries and the task dies before its first design.
        jobRole = 'arn:aws:iam::520168724997:role/NvidiaNimsBatch-BatchJobRole8F5EADCB-7v6zxNp7Byw5'
        // The MSA databases, mounted on the instance by the launch template
        // (iac msaCache). Read-only: both arms share one copy and neither
        // should be able to corrupt it mid-run. Harmless when the filesystem
        // is absent - the path simply does not exist, and only
        // OPENFOLD3_MSA_LOCAL looks for it.
        volumes = ['/fsx:/fsx:ro']
    }
}

workDir = 's3://nvidia-nims-workdir/work'

params {
    ecr_base = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims'
    // Default is the APDI build. Set to 'rfdiffusion-nim-code' for the
    // stack-matched container, which needs no NIM server or key.
    rfd_container_tag = 'rfdiffusion'
    // Set to 'proteinmpnn-seed-patch-v2' when using --pmpnn_seed; the stock
    // image has no -seed flag.
    pmpnn_container_tag = 'proteinmpnn'
    // Used only with --rfd_standalone. Manuel's build, which reproduces the
    // NIM's inference path without the NIM server.
    rfd_standalone_container_tag = 'rfdiffusion-fixed'
    // rfdiffusion-fixed ships no weights; it downloads them per task with the
    // NIM's own downloader, which needs this key. nextflow.config defaults it
    // to false, which would make every task in this arm exit 1.
    ngc_api_key_secret = 'nvidia-nims/ngc-api-key'
    ngc_api_key_region = 'us-east-1'
}

process {
    executor = 'awsbatch'
    queue = 'nvidia-nims-gpu-standard'
    resourceLabels = { ['project': 'nf-binder-design', 'profile': 'aws_batch_openfold', 'runName': workflow.runName] }

    // Record the instance each task actually landed on. Batch chooses the
    // instance and forgets it once the job ends, so a cost table built from
    // resource *requests* is a guess - a 2-vCPU job has been seen on a
    // g6e.4xlarge. This lands in .command.out in the task's work directory,
    // which persists, so provenance survives the instance.
    beforeScript = """
    _imds_token=\$(curl -sfX PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token 2>/dev/null || true)
    if [ -n "\${_imds_token:-}" ]; then
        echo "NXF_PROVENANCE instance_id=\$(curl -sf -H "X-aws-ec2-metadata-token: \${_imds_token}" http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null) instance_type=\$(curl -sf -H "X-aws-ec2-metadata-token: \${_imds_token}" http://169.254.169.254/latest/meta-data/instance-type 2>/dev/null) az=\$(curl -sf -H "X-aws-ec2-metadata-token: \${_imds_token}" http://169.254.169.254/latest/meta-data/placement/availability-zone 2>/dev/null) lifecycle=\$(curl -sf -H "X-aws-ec2-metadata-token: \${_imds_token}" http://169.254.169.254/latest/meta-data/instance-life-cycle 2>/dev/null)"
    fi
    """


    // nextflow.config sets maxRetries = 0, so the default 'terminate' would let
    // one transient Batch failure kill a whole run. 'ignore' drops the failed
    // design and carries on; 'finish' would stop submitting new work, ending
    // the arm with whatever had already been queued. The comparison must then
    // intersect on designs that survived in BOTH arms, or a design lost on one
    // side quietly biases the quality distribution.
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
    maxRetries = 3

    withName: RFDIFFUSION {
        container = "${params.ecr_base}:${params.rfd_container_tag}"
        accelerator = 1
        cpus = 2
        time = 24.hours
        memory = '16g'
    }

    // Manuel's build: NIM inference path, no NIM server. Hardware-matched to
    // RFDIFFUSION_NIM (1 gpu / 2 cpu / 16g) so the two sides are comparable.
    // Ships prebuilt TensorRT engines, so it should not pay the ~31 min engine
    // build the APDI image does - confirm that on the first run.
    withName: RFDIFFUSION_STANDALONE {
        container = "${params.ecr_base}:${params.rfd_standalone_container_tag}"
        accelerator = 1
        cpus = 2
        memory = '16g'
        time = 2.hours
    }

    // Hardware-matched to DL_BINDER_DESIGN_PROTEINMPNN_NIM (1 cpu / 8g / 1 gpu)
    // so the two sides land on comparable instances. Needs --pmpnn_gpu true,
    // otherwise the module pins itself to CPU with CUDA_VISIBLE_DEVICES="".
    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        container = "${params.ecr_base}:${params.pmpnn_container_tag}"
        accelerator = 1
        cpus = 1
        memory = '8g'
        time = 1.hour
    }

    // Used with --msa_shared_remote, so both pipelines call the public
    // ColabFold API through the same script. Matched to OPENFOLD3_MSA in the
    // NIM profile exactly, including maxForks and the retry policy, since the
    // service is shared and rate-limited by global traffic.
    withName: OPENFOLD3_MSA {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
        cpus = 2
        memory = '2g'
        time = 2.hours
        maxForks = 8
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }

    // Baseline counterpart to the MSA Search NIM. CPU-only: colabfold_search is
    // not GPU-accelerated, which is itself part of what the MSA step measures.
    // Reads its databases from the FSx mount, so nothing is staged.
    //
    // Memory is the open question here. ColabFold sizes its index to RAM and
    // wants it fully resident - ~128 GB batched, more for single queries - which
    // this queue cannot supply. params.msa_local_search_args defaults to
    // --db-load-mode 2 so the index is mmapped off FSx instead. If that proves
    // too slow, the fallback is a high-memory queue, not more args.
    withName: OPENFOLD3_MSA_LOCAL {
        queue = 'nvidia-nims-cpu-small'
        container = 'quay.io/nf-core/proteinfold_colabfold:1.1.1'
        cpus = 8
        // m5.2xlarge is the largest instance on this queue at 32 GiB, of which
        // ECS leaves ~30. Asking for 30g risks never placing, and an unplaced
        // job sits in RUNNABLE forever - the time directive only applies once
        // running. 24g leaves room.
        memory = '24g'
        time = 4.hours
        // Matched to OPENFOLD3_MSA on the NIM arm, so the MSA stage compares
        // two implementations rather than two concurrency limits.
        maxForks = 8
    }

    // Nextflow 24.04.3 interprets a bare shared-memory number as MiB, while
    // stable versions from 24.04.4 accept an explicit memory unit.
    withName: OPENFOLD3 {
        container = "${params.ecr_base}:openfold3-v0.5-pixi"
        accelerator = 1
        cpus = 8
        memory = '64g'
        time = 2.hours
        containerOptions = {
            def versionParts = workflow.nextflow.version.toString()
                .tokenize('-')[0]
                .tokenize('.')
                .collect { it as int }
            def supportsMemoryUnits = versionParts[0] > 24 ||
                (versionParts[0] == 24 &&
                    (versionParts[1] > 4 ||
                        (versionParts[1] == 4 && versionParts[2] >= 4)))
            supportsMemoryUnits ? '--shm-size 16g' : '--shm-size 16384'
        }
    }

    withName: BINDCRAFT_SCORING_AF2IG {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    withName: COMBINE_SCORES {
        executor = 'awsbatch'
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }

    withName: UNIQUE_ID {
        executor = 'awsbatch'
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }
}
