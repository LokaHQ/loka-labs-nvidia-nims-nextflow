// aws_batch.config
// Baseline (no NIMs) execution profile for running nf-binder-design's RFD method on
// AWS Batch. This is the "before" side of the NIM-accelerated benchmark — no NIM
// integration here by design; that's a separate, later phase.
//
// accelerator/memory/cpu/container requirements are already set per-process in the
// pipeline's own nextflow.config and module files — this profile only changes the
// execution target from local/HPC to AWS Batch.
//
// Queue, work-dir bucket, and region below point at the deployed "NvidiaNimsBatch"
// CDK stack (account 520168724997, us-east-1). Container overrides below point at
// the ECR mirror of these images — confirm they've finished pushing (see
// `aws ecr describe-images --repository-name nvidia-nims`) before running anything.

docker {
    enabled = true
}
apptainer {
    enabled = false   // pipeline defaults this to true; Batch runs Docker, not Apptainer
}

aws {
    region = 'us-east-1'
    batch {
        // Path to the AWS CLI baked onto the compute environment's instances via
        // launch-template user-data — required for S3 stage-in/out inside containers
        // that don't ship awscli themselves. Verified directly from the actual launch
        // template (lt-0306f07be0d43ca5f) used by our compute environments: its
        // user-data runs the official AWS CLI v2 installer with
        // `--bin-dir /opt/aws-cli/bin`.
        cliPath = '/opt/aws-cli/bin/aws'
    }
}

workDir = 's3://nvidia-nims-workdir/work'

params {
    // ECR mirror of the ghcr.io images this pipeline uses, in the "nvidia-nims" repo
    // (account 520168724997, us-east-1). Baseline (non-NIM) tags only — see
    // examples/pdl1-rfd/run-aws-batch.sh for the smoke test that exercises these.
    // Must live inside a config block, not a bare top-level `def` — Nextflow's
    // strict config parser rejects variable declarations mixed with config statements.
    ecr_base = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims'
}

process {
    executor = 'awsbatch'
    queue = 'nvidia-nims-gpu-standard'
    resourceLabels = { ['project': 'nf-binder-design', 'profile': 'aws_batch', 'runName': workflow.runName] }

    // rfdiffusion:pytorch2407
    // A second withName:RFDIFFUSION block does NOT merge with the one in root
    // nextflow.config — Nextflow replaces the whole block, so accelerator/cpus/time
    // must be repeated here too or they silently disappear (this bit us: the GPU
    // request vanished and jobs ran on CPU-only containers with no nvidia-smi).
    // Memory bumped to 16g (root sets 8g) to match the non-NIM minimum in the
    // smoke-test resource diagram: 1 CPU, 16GB RAM, 1 GPU.
    withName: RFDIFFUSION {
        container = "${params.ecr_base}:rfdiffusion"
        accelerator = 1
        cpus = 2
        time = 24.hours
        memory = '16g'
    }

    // proteinmpnn_dl_binder_design:latest
    // Same block-replacement gotcha as RFDIFFUSION above — repeating root
    // nextflow.config's cpus/memory/time here (1 CPU, 4GB RAM, no GPU — matches the
    // smoke-test diagram's non-NIM minimum) so they aren't silently dropped.
    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        container = "${params.ecr_base}:proteinmpnn"
        cpus = 1
        memory = '4g'
        time = 30.minutes
    }

    // af2_initial_guess:nv-cuda12
    // Same block-replacement gotcha — repeating root nextflow.config's
    // accelerator/cpus/memory/time here so they aren't silently dropped.
    withName: AF2_INITIAL_GUESS {
        container = "${params.ecr_base}:af2-initial-guess"
        accelerator = 1
        cpus = 4
        memory = '16g'
        time = 30.minutes
    }

    // bindcraft:nv-cuda12 — the module's own default (0366085-nv-cuda120) is a dead
    // tag on ghcr.io (manifest unknown); using the floating nv-cuda12 tag instead,
    // same convention as af2_initial_guess. Module default left as-is (out of scope
    // for this profile — see aws_batch.config's own scope).
    // No spec exists anywhere (module, nextflow.config, or the resource diagram) for
    // this process. CPU-only guess based on what bindcraft_scoring.py actually does
    // (DSSP/DAlphaBall metrics, not a model forward pass) — confirm before trusting.
    withName: BINDCRAFT_SCORING_AF2IG {
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    // nf-binder-design-utils:0.1.6
    // Root nextflow.config pins this to executor='local', which breaks when workDir
    // is S3 (Nextflow's local executor requires a POSIX filesystem). Override back to
    // awsbatch here.
    withName: COMBINE_SCORES {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }

    // No container in the module (it's a 5-line stdlib `secrets` script) and root
    // nextflow.config pins executor='local' — same S3/local-executor conflict as
    // COMBINE_SCORES above. Reusing nf-binder-design-utils since it's plain Python 3.
    withName: UNIQUE_ID {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }
}

// Other local-executor processes (GET_CONTIGS, RENUMBER_RESIDUES, FILTER_DESIGNS,
// AF2IG_SCORE_FILTER, BOLTZ_PULLDOWN_REPORTING, and more under other --method values)
// have the same S3-workDir conflict and aren't overridden here — out of scope for
// this RFD-method smoke test profile. Fix the same way (executor='awsbatch' + a
// container) before using this profile for those methods.
