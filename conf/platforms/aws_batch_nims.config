// NIM-accelerated variant of the aws_batch profile. RFDIFFUSION,
// DL_BINDER_DESIGN_PROTEINMPNN and the final refold/scoring step are all
// NIM-backed here - the last of those is OpenFold3 standing in for the
// baseline's AF2 initial guess (see modules/local/rfd/openfold3_nim.nf for how
// they differ).

docker {
    enabled = true
}
apptainer {
    enabled = false
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/opt/aws-cli/bin/aws'
        jobRole = 'arn:aws:iam::520168724997:role/NvidiaNimsBatch-BatchJobRole8F5EADCB-7v6zxNp7Byw5'
    }
}

workDir = 's3://nvidia-nims-workdir/work'

params {
    ecr_base = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims'
    openfold3_nim_image = false
    ngc_api_key_secret = 'nvidia-nims/ngc-api-key'
    ngc_api_key_region = 'us-east-1'
}

process {
    executor = 'awsbatch'
    queue = 'nvidia-nims-gpu-standard'
    resourceLabels = { ['project': 'nf-binder-design', 'profile': 'aws_batch_nims', 'runName': workflow.runName] }

    withName: RFDIFFUSION_NIM {
        container = "${params.ecr_base}:rfdiffusion-nim"
        accelerator = 1
        cpus = 2
        memory = '16g'
        time = 1.hour
    }

    withName: DL_BINDER_DESIGN_PROTEINMPNN_NIM {
        container = "${params.ecr_base}:proteinmpnn-nim"
        accelerator = 1
        cpus = 1
        memory = '8g'
        time = 1.hour
    }

    withName: THREAD_AND_RELAX {
        queue = 'nvidia-nims-cpu-small'
        cpus = 1
        memory = '4g'
        time = 30.minutes
    }

    withName: OPENFOLD3_MSA {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
        cpus = 2
        memory = '2g'
        time = 2.hours
        maxForks = 1
    }

    // NVIDIA's support matrix asks for 8+ cores and 64+ GB RAM. Requesting a
    // full 64g pushes this onto g6e.4xlarge, since not all of a g6e.2xlarge's
    // 64 GiB is schedulable once ECS takes its cut. Disk (~80 GB needed) comes
    // from the gpu_standard queue's 200 GiB launch-template volume - AWS Batch
    // has no disk resource requirement, so there is no directive for it.
    // nf-amazon 2.5.2, bundled with supported Nextflow 24.04.3, parses this
    // value directly as MiB and rejects unit suffixes. It must also be
    // space-separated, not "=" (nextflow-io/nextflow#5190).
    withName: OPENFOLD3_NIM {
        container = params.openfold3_nim_image ?: "${params.ecr_base}:openfold3-nim"
        accelerator = 1
        cpus = 8
        memory = '64g'
        time = 2.hours
        containerOptions = '--shm-size 16384'
    }

    withName: OPENFOLD3_SCORE_FILTER {
        executor = 'awsbatch'
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
        cpus = 1
        memory = '1g'
        time = 10.minutes
    }

    withName: BINDCRAFT_SCORING_OPENFOLD3 {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    // Retained for non-NIM workflows launched with this profile.
    withName: BINDCRAFT_SCORING_AF2IG {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    withName: COMBINE_SCORES {
        executor = 'awsbatch'
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }

    withName: UNIQUE_ID {
        executor = 'awsbatch'
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }
}
