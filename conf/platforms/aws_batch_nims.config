// NIM-accelerated variant of the aws_batch profile. RFDIFFUSION,
// DL_BINDER_DESIGN_PROTEINMPNN and the final refold/scoring step are all
// NIM-backed here - the last of those is OpenFold3 standing in for the
// baseline's AF2 initial guess (see modules/local/rfd/openfold3_nim.nf for how
// they differ).

docker {
    enabled = true
}
apptainer {
    enabled = false
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/opt/aws-cli/bin/aws'
        jobRole = 'arn:aws:iam::520168724997:role/NvidiaNimsBatch-BatchJobRole8F5EADCB-7v6zxNp7Byw5'
        // Same MSA databases the baseline arm reads, so the two sides search
        // identical files. Writable because this is the NIM's own cache
        // directory and it may touch locks or manifests there even when fully
        // populated - discovering that mid-benchmark would waste a run. The
        // baseline arm, which only ever reads, mounts the same path read-only.
        // The contents are re-downloadable if a run does damage them.
        volumes = ['/fsx:/fsx:rw']
    }
}

workDir = 's3://nvidia-nims-workdir/work'

params {
    ecr_base = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims'
    openfold3_nim_image = false
    ngc_api_key_secret = 'nvidia-nims/ngc-api-key'
    ngc_api_key_region = 'us-east-1'
}

process {
    executor = 'awsbatch'
    queue = 'nvidia-nims-gpu-standard'
    resourceLabels = { ['project': 'nf-binder-design', 'profile': 'aws_batch_nims', 'runName': workflow.runName] }

    // nextflow.config sets maxRetries = 0, so the default 'terminate' would let
    // one transient Batch failure kill a whole run. 'ignore' drops the failed
    // design and carries on; 'finish' would stop submitting new work, ending
    // the arm with whatever had already been queued. Must match the baseline
    // arm, and the comparison must intersect on designs that survived in both.
    errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
    maxRetries = 3

    withName: RFDIFFUSION_NIM {
        container = "${params.ecr_base}:rfdiffusion-nim"
        accelerator = 1
        cpus = 2
        memory = '16g'
        time = 1.hour
    }

    withName: DL_BINDER_DESIGN_PROTEINMPNN_NIM {
        container = "${params.ecr_base}:proteinmpnn-nim"
        accelerator = 1
        cpus = 1
        memory = '8g'
        time = 1.hour
    }

    withName: THREAD_AND_RELAX {
        queue = 'nvidia-nims-cpu-small'
        cpus = 1
        memory = '4g'
        time = 30.minutes
    }

    withName: OPENFOLD3_MSA {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
        cpus = 2
        memory = '2g'
        time = 2.hours
        // Was 1, for the rate-limited public ColabFold API. Serialising 100
        // designs added hours of wall clock to the arm for ~3s of work each.
        // Lower this again if a run starts failing on rate limits.
        maxForks = 8
        // The public ColabFold API is shared/rate-limited by global traffic,
        // not just our own requests - its own internal retry (5 attempts,
        // ~50-75s) isn't always enough to ride out a busy period.
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }

    // Self-hosted MSA Search NIM, the counterpart to the baseline's
    // colabfold_search. GPU Server holds the databases in memory and NVIDIA's
    // matrix requires two 48 GB cards, so this cannot run on gpu-standard's
    // single-L40S g6e.2xlarge - it goes to gpu-highmem (g6e.12xlarge, 4x L40S)
    // at ~$10.49/h on demand.
    //
    // That cost lands on this arm per design and is worth stating in the
    // write-up: the NIM's MSA is GPU-backed where the baseline's is CPU.
    withName: OPENFOLD3_MSA_NIM {
        queue = 'nvidia-nims-gpu-highmem'
        container = "${params.ecr_base}:msa-search-updated"
        accelerator = 2
        cpus = 24
        memory = '64g'
        time = 4.hours
        // Matched to OPENFOLD3_MSA_LOCAL so the MSA stage compares two
        // implementations rather than two concurrency limits.
        maxForks = 8
    }

    // NVIDIA's support matrix asks for 8+ cores and 64+ GB RAM. Requesting a
    // full 64g pushes this onto g6e.4xlarge, since not all of a g6e.2xlarge's
    // 64 GiB is schedulable once ECS takes its cut. Disk (~80 GB needed) comes
    // from the gpu_standard queue's 200 GiB launch-template volume - AWS Batch
    // has no disk resource requirement, so there is no directive for it.
    // Nextflow 24.04.3's AWS plugin reads shm-size as MiB. Supported stable
    // releases from 24.04.4 parse it as a memory value and require a unit.
    // Select the form from the running version so both parser generations
    // register the same 16 GiB Batch job definition.
    withName: OPENFOLD3_NIM {
        container = params.openfold3_nim_image ?: "${params.ecr_base}:openfold3-nim"
        accelerator = 1
        cpus = 8
        memory = '64g'
        time = 2.hours
        containerOptions = {
            def versionParts = workflow.nextflow.version.toString()
                .tokenize('-')[0]
                .tokenize('.')
                .collect { it as int }
            def supportsMemoryUnits = versionParts[0] > 24 ||
                (versionParts[0] == 24 &&
                    (versionParts[1] > 4 ||
                        (versionParts[1] == 4 && versionParts[2] >= 4)))
            supportsMemoryUnits ? '--shm-size 16g' : '--shm-size 16384'
        }
    }

    withName: BINDCRAFT_SCORING_OPENFOLD3 {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    // Retained for non-NIM workflows launched with this profile.
    withName: BINDCRAFT_SCORING_AF2IG {
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    withName: COMBINE_SCORES {
        executor = 'awsbatch'
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }

    withName: UNIQUE_ID {
        executor = 'awsbatch'
        queue = 'nvidia-nims-cpu-small'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }
}
