// Baseline (no NIMs) profile, AF2 scoring. See aws_batch_openfold.config for
// the OpenFold3 variant.

docker {
    enabled = true
}
apptainer {
    enabled = false
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/opt/aws-cli/bin/aws'
    }
}

workDir = 's3://nvidia-nims-workdir/work'

params {
    ecr_base = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims'
}

process {
    executor = 'awsbatch'
    queue = 'nvidia-nims-gpu-standard'
    resourceLabels = { ['project': 'nf-binder-design', 'profile': 'aws_batch_af2', 'runName': workflow.runName] }

    // withName blocks don't merge with root nextflow.config, they replace it -
    // repeat all directives here or they silently drop.
    withName: RFDIFFUSION {
        container = "${params.ecr_base}:rfdiffusion"
        accelerator = 1
        cpus = 2
        time = 24.hours
        memory = '16g'
    }

    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        container = "${params.ecr_base}:proteinmpnn"
        cpus = 1
        memory = '4g'
        time = 30.minutes
    }

    withName: AF2_INITIAL_GUESS {
        container = "${params.ecr_base}:af2-initial-guess"
        accelerator = 1
        cpus = 4
        memory = '16g'
        time = 30.minutes
    }

    // CPU-only: DSSP/DAlphaBall metrics, no model forward pass.
    withName: BINDCRAFT_SCORING_AF2IG {
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    withName: COMBINE_SCORES {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }

    withName: UNIQUE_ID {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }
}
