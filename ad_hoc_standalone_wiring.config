// Ad-hoc supplement for rfd_standalone_wiring_check.nf: adds the OSS-side
// process configs that aws_batch_nims.config doesn't define, since that profile
// only runs NIM-named processes. Use with
// `-profile aws_batch_nims -c ad_hoc_standalone_wiring.config`.
params {
    rfd_standalone_container_tag = 'rfdiffusion-fixed'
}

process {
    // Hardware-matched to RFDIFFUSION_NIM in the profile (1 gpu / 2 cpu / 16g)
    // so the comparison is not confounded by the instance it landed on.
    withName: RFDIFFUSION_STANDALONE {
        container = "520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims:${params.rfd_standalone_container_tag}"
        accelerator = 1
        cpus = 2
        memory = '16g'
        // Generous: if the image turns out not to ship usable engines it will
        // build them (~31 min), and that result is itself worth having rather
        // than a timeout.
        time = 2.hours
    }

    withName: COMPARE_BACKBONES {
        queue = 'nvidia-nims-cpu-small'
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }
}
