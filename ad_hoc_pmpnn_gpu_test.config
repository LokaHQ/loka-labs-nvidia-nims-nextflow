// Ad-hoc, for a hardware-matched ProteinMPNN comparability test only. Use with
// `-profile aws_batch_openfold -c ad_hoc_pmpnn_gpu_test.config --pmpnn_gpu true`
// to run baseline ProteinMPNN on GPU instead of the default CPU-pinned path.
process {
    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        queue = 'nvidia-nims-gpu-standard'
        accelerator = 1
        cpus = 2
        memory = '16g'
        time = 30.minutes
    }
}
