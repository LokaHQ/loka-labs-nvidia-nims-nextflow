// Ad-hoc, for the checkpoint-matched ProteinMPNN comparison only. Runs the
// seed-patched non-NIM ProteinMPNN on GPU with NIM-matched resources, and
// sets the seed per process via ext.args: run A keeps seed 0, run B uses
// seed 102 to match the value NIM reported in its own FASTA header.
process {
    withName: '.*MPNN_OSS_CKPT002.*' {
        container = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims:proteinmpnn-seed-patch-v2'
        queue = 'nvidia-nims-gpu-standard'
        accelerator = 1
        cpus = 1
        memory = '8g'
        time = 1.hour
    }
    withName: 'MPNN_OSS_CKPT002_SEED0' {
        ext.args = '-seed 0'
    }
    withName: 'MPNN_OSS_CKPT002_SEED102' {
        ext.args = '-seed 102'
    }
}
