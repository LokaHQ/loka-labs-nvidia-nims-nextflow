// Ad-hoc, for the hardware-matched ProteinMPNN comparison only. Runs the
// seed-patched non-NIM ProteinMPNN on a GPU with the SAME resource request
// as DL_BINDER_DESIGN_PROTEINMPNN_NIM (1 cpu / 8g / 1 gpu), so Batch is
// likely to place both on the same instance type. Without this, non-NIM
// ProteinMPNN runs CPU-only (CUDA_VISIBLE_DEVICES="" in the module), which
// confounds the NIM-vs-non-NIM sequence comparison with a GPU-vs-CPU
// difference. Use with `--pmpnn_gpu true` so the module skips its CPU pin,
// plus `-c ad_hoc_mixed.config`.
process {
    withName: '.*MPNN_OSS.*' {
        container = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims:proteinmpnn-seed-patch-v2'
        queue = 'nvidia-nims-gpu-standard'
        accelerator = 1
        cpus = 1
        memory = '8g'
        time = 1.hour
    }
}
