{
  "name": "@lokahq/nf-binder-design-iac",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "compile": "tsc --pretty --noEmit",
    "bootstrap": "cdk bootstrap --tags Project=nvidia-nims",
    "deploy": "cdk deploy --tags Project=nvidia-nims",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --check src/ test/",
    "fmt:fix": "oxfmt --write src/ test/",
    "test": "jest",
    "test:fix": "jest --updateSnapshot"
  },
  "dependencies": {
    "aws-cdk": "^2.1115.1",
    "aws-cdk-lib": "^2.246.0",
    "constructs": "^10.6.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "jest": "^30.3.0",
    "jest-cdk-snapshot": "^2.3.6",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.2"
  },
  "engines": {
    "npm": "please-use-yarn",
    "node": ">=22",
    "yarn": "~1.22.0 <2"
  }
}
