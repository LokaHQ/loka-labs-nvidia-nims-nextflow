      "Properties": {
        "Bucket": {
          "Ref": "StorageInputBucket0767FBBB",
        },
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false",
                },
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*",
              },
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "StorageInputBucket0767FBBB",
                    "Arn",
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "StorageInputBucket0767FBBB",
                          "Arn",
                        ],
                      },
                      "/*",
                    ],
                  ],
                },
              ],
            },
            {
              "Action": "s3:*",
              "Condition": {
                "BoolIfExists": {
                  "aws:PrincipalIsAWSService": "false",
                },
                "StringNotLike": {
                  "aws:PrincipalArn": [
                    {
                      "Fn::GetAtt": [
                        "BatchJobRole8F5EADCB",
                        "Arn",
                      ],
                    },
                    {
                      "Fn::GetAtt": [
                        "BatchInstanceRole6B185052",
                        "Arn",
                      ],
                    },
