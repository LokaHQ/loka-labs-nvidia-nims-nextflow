                    "arn:aws:iam::123456789012:role/cdk-*",
                    "arn:aws:iam::520168724997:role/aws-reserved/sso.amazonaws.com/*",
                  ],
                },
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*",
              },
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "StorageInputBucket0767FBBB",
                    "Arn",
                  ],
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
