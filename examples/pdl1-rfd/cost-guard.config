// Run-specific cost guard for the batch validation run. Not part of the
// published benchmark config.
//
// ProteinMPNN NIM does 6.6 s of GPU work per design but has no maxForks, so
// N designs can claim N GPU instances. Provisioning, not compute, is then the
// bill. Capping forks makes Batch reuse a few instances instead.
process {
    withName: DL_BINDER_DESIGN_PROTEINMPNN_NIM {
        maxForks = 4
    }
    withName: BINDCRAFT_SCORING_OPENFOLD3 {
        maxForks = 6
    }
}
