// Ad-hoc, for the RFdiffusion RNGs-seeding-patch test only. Points RFDIFFUSION
// at the experimental patched image instead of the stock one. Use with
// `-profile aws_batch_nims -c ad_hoc_seed_patch_test.config`.
process {
    withName: RFDIFFUSION {
        container = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims:rfdiffusion-seed-patch-v3'
        accelerator = 1
        cpus = 2
        time = 24.hours
        memory = '16g'
    }
}
