// Ad-hoc supplement for msa_db_download.nf. Use with
// `-profile aws_batch_nims -c ad_hoc_msa_db_download.config`.
//
// The filesystem lives in one subnet (us-east-1a) while this queue spans four,
// and Batch picks the subnet, so three runs in four write ~1.2 TB across an AZ
// boundary - slower, and billed as cross-AZ transfer. The job records which AZ
// it landed in rather than pretending to control it. Acceptable for a one-off
// load; if it matters later the fix is a compute environment confined to 1a.
// The profiles mount /fsx read-only, which is right for the pipeline but stops
// the loader writing. Override just for this job.
aws {
    batch {
        volumes = ['/fsx:/fsx:rw']
    }
}

process {
    withName: DOWNLOAD_NIM_DATABASES {
        queue = 'nvidia-nims-cpu-small'
        container = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims:msa-search-updated'
        cpus = 4
        memory = '16g'
        // The FSx root is root-owned, and this image runs as a non-root user,
        // so it cannot create the database directory. Run the loader as root
        // and hand ownership to the NIM's uid afterwards.
        containerOptions = '--user root'
        // ~1.2 TB at the ~460 MB/s seen earlier is well under an hour, but NGC
        // throughput varies and a part-finished download wastes the whole run.
        time = 12.hours
        // The download resumes, so a retry after a spot reclaim picks up where
        // it stopped rather than starting again.
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries = 3
    }
}
